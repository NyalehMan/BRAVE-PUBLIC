# Deployment routing. prepare-env.sh fills these values.
BRAVE_HOSTNAME=CHANGE_ME_HOSTNAME
ACME_EMAIL=CHANGE_ME_EMAIL

# Laravel production configuration.
APP_NAME=BRAVE
APP_ENV=production
APP_KEY=CHANGE_ME_APP_KEY
APP_DEBUG=false
APP_URL=https://CHANGE_ME_HOSTNAME
FRONTEND_URL=https://nyalehman.github.io
CORS_ALLOWED_ORIGINS=https://nyalehman.github.io
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cross-site cookies are needed when the GitHub Pages frontend calls Oracle.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=nyalehman.github.io,CHANGE_ME_HOSTNAME

# PostgreSQL stays inside Docker and is never exposed to the internet.
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=brave_public
DB_USERNAME=brave
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=disable

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
REPORT_PHOTO_DISK=local
RUN_MIGRATIONS=true
TESSERACT_PATH=/usr/bin/tesseract

# WhatsApp Cloud API. Replace placeholders only in the server's private .env.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_VERIFY_TOKEN
WHATSAPP_APP_SECRET=CHANGE_ME_WHATSAPP_APP_SECRET
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_SEND_REPLIES=true

# MapTiler is embedded in the browser bundle. Restrict this key to the GitHub
# Pages and Oracle hostnames in the MapTiler dashboard.
VITE_MAPTILER_API_KEY=CHANGE_ME_MAPTILER_KEY

# ArcGIS is called only by Laravel. Do not commit these production values.
ARCGIS_FIRE_INCIDENT_LAYER_URL=CHANGE_ME_FIRE_LAYER_URL
ARCGIS_FLOOD_INCIDENT_LAYER_URL=CHANGE_ME_FLOOD_LAYER_URL
ARCGIS_FLOOD_WEBMAP_ID=17813afa14a4419583dc2a136bf51d99
ARCGIS_TOKEN=CHANGE_ME_ARCGIS_TOKEN
ARCGIS_REFERER=https://CHANGE_ME_HOSTNAME
